server:
  http_listen_port: 9080
  grpc_listen_port: 0

clients:
  - url: http://100.96.89.115:3100/loki/api/v1/push

scrape_configs:
  - job_name: docker_containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ["__meta_docker_container_name"]
        regex: "/(.*)"
        target_label: "container"

    pipeline_stages:
      - docker: {}
      - match:
          selector: '{container="traefik"}'
          stages:
            - json:
                expressions:
                  ClientHost: ClientHost
            - geoip:
                db: "/etc/promtail/GeoLite2-City.mmdb"
                source: ClientHost
                db_type: city
            - labels:
                geoip_country_name:
                geoip_city_name:
